# ============================================================================
# REQUIRED - Application will not start without these
# ============================================================================
SECRET_KEY=your-long-random-secret-key-at-least-50-chars
DB_PASSWORD=your-database-password

# ============================================================================
# REQUIRED FOR EMAIL - Application runs but email sending will fail without these
# ============================================================================
EMAIL_HOST_PASSWORD=your-gmail-app-password

# ============================================================================
# REQUIRED FOR FILE UPLOADS - Application runs but uploads will fail without these
# ============================================================================
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ============================================================================
# OPTIONAL - Sensible defaults provided
# ============================================================================
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,localhost,127.0.0.1
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mydatabase
DB_USER=myuser
DB_HOST=localhost
DB_PORT=5434
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.1:6379/0
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_TIMEOUT=60
CLOUDINARY_CLOUD_NAME=your-cloud-name
TIME_ZONE=Asia/Kathmandu

# ============================================================================
# OPTIONAL - Operational tuning (defaults are fine for development)
# ============================================================================
MAILING_CHUNK_SIZE=200
MAILING_MAX_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=50
MAX_RECIPIENTS_LIMIT=50000
SMTP_THROTTLE_SECONDS=0.1
STUCK_CHUNK_THRESHOLD_HOURS=2
BULK_MAIL_RATE_LIMIT=10/m